{
  "version": 1,
  "modo": "audit",
  "descripcion": "La plantilla no asume rutas de aplicación. Declara solo propiedad documental durable; /sdd-init o /onboard proponen territorios de aplicación.",
  "territories": [
    {
      "name": "arquitectura-sdd",
      "agent": "architect",
      "paths": ["docs/architecture/**"]
    },
    {
      "name": "especificacion-sdd",
      "agent": "spec-analyst",
      "paths": [
        "docs/specs/**/spec.md",
        "docs/specs/**/clarifications.md",
        "docs/product/PRD.md",
        "docs/product/USE-CASES.md",
        "docs/product/FEATURE-MAP.md",
        "docs/product/SOURCES.md"
      ]
    },
    {
      "name": "diseno-sdd",
      "agent": "ux-designer",
      "paths": ["docs/design/**"]
    },
    {
      "name": "documentacion-lectores",
      "agent": "docs-writer",
      "paths": ["README.md", "CONTRIBUTING.md", "docs/README.md", "docs/guides/**", "docs/api/**", ".sdd/docs.json"]
    },
    {
      "name": "memoria-proyecto",
      "agent": "bitacora-keeper",
      "paths": ["docs/bitacora/**"]
    },
    {
      "name": "entrega-publica",
      "agent": "release-manager",
      "paths": ["CHANGELOG.md"]
    },
    {
      "name": "operacion-sdd",
      "agent": "devops-expert",
      "paths": ["docs/ops/**"]
    }
  ]
}

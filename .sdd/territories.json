{
  "version": 1,
  "modo": "audit",
  "descripcion": "La plantilla no asume rutas de aplicación. /sdd-init o /onboard proponen territorios a partir del proyecto real.",
  "territories": [
    {
      "name": "arquitectura-sdd",
      "agent": "architect",
      "paths": ["docs/architecture/**"]
    },
    {
      "name": "especificacion-sdd",
      "agent": "spec-analyst",
      "paths": [
        "docs/specs/**/spec.md",
        "docs/specs/**/clarifications.md",
        "docs/product/PRD.md",
        "docs/product/USE-CASES.md",
        "docs/product/FEATURE-MAP.md",
        "docs/product/SOURCES.md"
      ]
    },
    {
      "name": "diseno-sdd",
      "agent": "ux-designer",
      "paths": ["docs/design/**"]
    },
    {
      "name": "operacion-sdd",
      "agent": "devops-expert",
      "paths": ["docs/ops/**"]
    }
  ]
}

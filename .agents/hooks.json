{
  "hooks": {
    "preToolUse": [
      {
        "matcher": { "toolNames": ["run_command", "run_terminal_command", "execute_command"] },
        "command": "node ./.claude/hooks/guard-bash.mjs --host=antigravity"
      },
      {
        "matcher": { "toolNames": ["write_file", "create_file", "edit_file", "replace_file_content", "delete_file"] },
        "command": "node ./.claude/hooks/guard-write.mjs --host=antigravity"
      }
    ],
    "postToolUse": [
      {
        "matcher": { "toolNames": ["write_file", "create_file", "edit_file", "replace_file_content"] },
        "command": "node ./.claude/hooks/format-and-lint.mjs"
      }
    ],
    "stop": [
      { "command": "node ./.claude/hooks/session-log.mjs" }
    ]
  }
}

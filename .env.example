# Copia este fichero a `.env` y rellena los valores.
# `.env` NUNCA se commitea: está en .gitignore y los hooks bloquean su lectura y escritura.

# ─── Servidores MCP ──────────────────────────────────────────────────────────

# Context7 — documentación actualizada de librerías
CONTEXT7_API_KEY=

# Supabase — esquema, migraciones, RLS, advisors
# Token personal: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Google Stitch — generación de UI
STITCH_API_KEY=

# GitHub — issues, PRs, revisiones. Alcance mínimo: repo, read:org
GITHUB_PERSONAL_ACCESS_TOKEN=

# Figma no necesita clave: usa el servidor MCP local del escritorio
# (Dev Mode → panel Inspect → Enable desktop MCP server, en 127.0.0.1:3845)

# ─── Circuito SDD ────────────────────────────────────────────────────────────

# `off` desactiva los gates de los hooks (secretos, comandos peligrosos, avisos TDD).
# Úsalo solo puntualmente.
SDD_GATES=on
SDD_SPECS_DIR=docs/specs
SDD_BITACORA=docs/bitacora/DECISIONS.md

# ─── Aplicación ──────────────────────────────────────────────────────────────
# Añade aquí las variables de tu proyecto, con el nombre pero SIN el valor.

# DATABASE_URL=
# NODE_ENV=development
# LOG_LEVEL=info
